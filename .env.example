# 阿里云百炼（DashScope）API Key
# 申请地址：https://bailian.console.aliyun.com/
# 复制本文件为 .env 并填入真实 Key；.env 已被 .gitignore 排除，不会入库。
DASHSCOPE_API_KEY=

# MiniMax Speech 2.8（speech-2.8-hd / speech-2.8-turbo）API Key
# 申请地址：https://platform.minimaxi.com/
# 与上面的百炼 Key 完全独立：两套 provider 可以共存，各自按需配置。
MINIMAX_API_KEY=

# MiniMax GroupId（可选）
# 新版 Platform API Key 不需要 GroupId，留空即可；老版分组账号需填。
MINIMAX_GROUP_ID=
